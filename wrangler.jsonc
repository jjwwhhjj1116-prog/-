{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "concost-tech-scheduler",
  "compatibility_date": "2026-09-18",
  "pages_build_output_dir": "scheduler-web/dist",
  "services": [{"binding":"CLAIM_WORKLOGS","service":"concost-claim-center-preview","entrypoint":"ClaimWorklogs"}],
  "vars": {
    "CIVIL_APPROVER_ID": "u_8",
    "GEMINI_MODEL": "gemini-3.1-flash-lite"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "concost-tech-scheduler-db",
      "database_id": "28a9c32b-647d-47de-a916-d966327b35ca"
    }
  ]
}
